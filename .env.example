# I44 Hotels - environment variables
# Copy to .env.local for local dev, and set these in the Cloudflare dashboard
# (Workers & Pages > your project > Settings > Variables) for production.
# Never commit real values; .env.local is gitignored.

# --- Resend (inquiry form email delivery) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "I44 Hotels <inquiries@i44hotels.com>"
INQUIRY_FROM_EMAIL=
# Where inquiries are delivered (your inbox), e.g. "frontdesk@i44hotels.com"
INQUIRY_TO_EMAIL=

# --- Form anti-abuse ---
# Secret used to sign the form timing token (HMAC). Use a long random string.
# Generate one with: openssl rand -hex 32
FORM_SECRET=

# --- Cloudflare Turnstile (bot challenge) ---
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (sent to the browser); secret key stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
